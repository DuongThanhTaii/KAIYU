# Environment variables declared in this file are automatically made available to Prisma.
# Copy this file to .env and fill in your values

# Database connection string for Neon.tech PostgreSQL
DATABASE_URL='postgresql://user:password@host/database?sslmode=require'

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Server
PORT=3001

# Google OAuth (Get from Google Cloud Console)
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing
# 3. Go to APIs & Services > Credentials
# 4. Create OAuth 2.0 Client ID (Web application)
# 5. Add authorized redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# AWS S3 Configuration (Optional - for video/image uploads)
# 1. Go to AWS Console > S3 > Create bucket
# 2. Bucket permissions: Enable "Block all public access" = OFF for public files
# 3. Go to IAM > Create user with S3FullAccess
# 4. Create Access Key for the user
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name

#WHISPER
NEXT_PUBLIC_WHISPER_API_URL=http://your-whisper-server:9000

# Cloudflare Realtime Analytics (Optional, recommended for Cloudflare-style dashboard)
# Create an API token with Analytics read permission for the target zone.
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ANALYTICS_DOMAIN=your-domain.com

# Analytics Permissions (Optional)
# If empty, all admins can view infrastructure analytics.
ANALYTICS_INFRA_ALLOWED_EMAILS=admin@example.com
# Only these emails (or role super_admin) can manage analytics settings.
ANALYTICS_MANAGE_ALLOWED_EMAILS=owner@example.com
# Stream refresh interval constraints in seconds.
ANALYTICS_MIN_STREAM_INTERVAL_SEC=3
ANALYTICS_DEFAULT_STREAM_INTERVAL_SEC=5
ANALYTICS_MAX_STREAM_INTERVAL_SEC=30

# Nginx analytics ingest key (required for non-Cloudflare traffic analytics pipeline)
ANALYTICS_INGEST_KEY=your-strong-random-ingest-key
